#!/bin/sh
set -eu

plugin_id=io.github.digitalpals.omarchy-t3code
legacy_plugin_id=io.github.omarchy-t3code
artifact_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
source_dir=$artifact_root/plugin
omarchy_command=${OMARCHY_COMMAND:-omarchy}

if [ ! -f "$source_dir/manifest.json" ] || [ ! -x "$source_dir/lib/t3-mini-bridge" ]; then
  echo "This installer must remain beside the packaged plugin directory." >&2
  exit 1
fi

"$omarchy_command" plugin validate "$source_dir"

config_root=${XDG_CONFIG_HOME:-${HOME:?HOME is required}/.config}
plugins_root=$config_root/omarchy/plugins
target=$plugins_root/$plugin_id
legacy_target=$plugins_root/$legacy_plugin_id
stage=$plugins_root/.$plugin_id.install-$$
backup_root=$plugins_root/.backups
backup=
backup_source=

cleanup() {
  if [ -d "$stage" ]; then rm -r -- "$stage"; fi
}
trap cleanup EXIT HUP INT TERM

mkdir -p -m 700 "$plugins_root"
cp -a -- "$source_dir" "$stage"

if [ -e "$target" ] || [ -e "$legacy_target" ]; then
  mkdir -p -m 700 "$backup_root"
  backup=$backup_root/$plugin_id-$(date -u +%Y%m%dT%H%M%SZ)-$$
  if [ -e "$target" ]; then backup_source=$target; else backup_source=$legacy_target; fi
  mv -- "$backup_source" "$backup"
fi

if ! mv -- "$stage" "$target"; then
  if [ -n "$backup" ] && [ ! -e "$backup_source" ]; then mv -- "$backup" "$backup_source"; fi
  exit 1
fi

# The pre-publication ID may exist beside a newer installation. Once the new
# target is safely in place, remove only that exact obsolete directory.
if [ -e "$legacy_target" ]; then rm -r -- "$legacy_target"; fi

if [ -n "$backup" ]; then
  find "$backup_root" -mindepth 1 -maxdepth 1 -type d \
    \( -name "$plugin_id-*" -o -name "$legacy_plugin_id-*" \) \
    ! -path "$backup" -exec rm -r -- {} +
  echo "Previous installation retained at $backup"
elif [ -d "$backup_root" ]; then
  find "$backup_root" -mindepth 1 -maxdepth 1 -type d \
    \( -name "$plugin_id-*" -o -name "$legacy_plugin_id-*" \) \
    -exec rm -r -- {} +
fi

if "$omarchy_command" shell -q shell ping >/dev/null 2>&1; then
  "$omarchy_command" shell shell rescanPlugins
  "$omarchy_command" bar put "$plugin_id" --section right --index 0
  echo "Installed and enabled $plugin_id."
else
  echo "Installed $plugin_id. Restart Omarchy, then run: omarchy bar put $plugin_id --section right --index 0"
fi
