#!/bin/bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
qmlformat_bin=${QMLFORMAT_BIN:-/usr/lib/qt6/bin/qmlformat}
qmllint_bin=${QMLLINT_BIN:-/usr/lib/qt6/bin/qmllint}

for file in "$repo_root"/plugin/qml/*.qml; do
  "$qmlformat_bin" --ignore-settings "$file" >/dev/null
done

omarchy plugin validate "$repo_root/plugin"

qml_import_root=$(mktemp -d)
qml_report=$(mktemp)
qml_smoke_root=$(mktemp -d)
trap 'rm -r "$qml_import_root" "$qml_smoke_root"; rm -f "$qml_report"' EXIT
mkdir -p "$qml_import_root/qs"
ln -s /usr/share/omarchy/shell/Commons "$qml_import_root/qs/Commons"
ln -s /usr/share/omarchy/shell/Ui "$qml_import_root/qs/Ui"

"$qmllint_bin" -I "$qml_import_root" "$repo_root"/plugin/qml/*.qml >"$qml_report" 2>&1
if rg '^Warning:.*(was not found|not resolved|unknown grouped property|Cannot assign|Could not compile|incompatible type|inheritance cycle)' "$qml_report" \
  | rg -qv 'QProcess::ExitStatus'; then
  cat "$qml_report" >&2
  exit 1
fi

cp "$repo_root/tests/qml/Smoke.qml" "$qml_smoke_root/shell.qml"
cp -r "$repo_root/plugin/qml" "$qml_smoke_root/plugin-qml"

# KeyboardPanel is a native layer-shell surface, so Quickshell can only load
# its PanelWindow backend inside a Wayland session. Keep the content smoke test
# available to headless CI, while exercising the complete modal whenever a
# compositor is available.
qml_platform=offscreen
qml_check_modal=0
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  qml_platform=wayland
  qml_check_modal=1
fi
qml_output=$(QML_IMPORT_PATH="$qml_import_root" \
  QT_QPA_PLATFORM="$qml_platform" \
  T3_QML_CHECK_MODAL="$qml_check_modal" \
  timeout 10s quickshell -p "$qml_smoke_root/shell.qml" 2>&1)
if [[ $qml_output != *T3_QML_SMOKE_OK* ]] || [[ $qml_output == *T3_QML_ERROR* ]]; then
  printf '%s\n' "$qml_output" >&2
  exit 1
fi

echo "QML manifest, syntax, imports, and component compilation passed."
